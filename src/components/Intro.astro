---
// First-visit intro: welcome lines → our Milky Way → a dive to the Sun → the solar system → Earth,
// which becomes the live globe. A port of the approved HyperFrames previz (SPEC.md passes 3–6: the
// Milky Way in WebGL, the K = 0.85 pace, the travel audio); the motion lives in src/lib/intro/. Shown
// only under html.splash (set by Layout.astro's head script on a first visit, see #splash in
// global.css); the script removes the overlay when it is done. Esc ends it early.
// Imagery: NASA/JPL-Caltech/R. Hurt (galaxy), ESO/S. Brunier (sky), Solar System Scope (planets);
// credited in Footer.tsx.
---

<div id="splash" class="fixed inset-0 z-[100] overflow-hidden bg-black">
  <div id="intro-ground" class="absolute inset-0 bg-black"></div>
  <div id="intro-stage" class="absolute inset-0 overflow-hidden opacity-0">
    <!-- galaxy.ts: the photo is fetched by the script on a first visit only, so returning visitors
         never download it. -->
    <canvas id="intro-galaxy" class="absolute inset-0 block size-full"></canvas>
  </div>
  <!-- The star shader writes dim colour at high alpha; screen only ever adds light over the galaxy. -->
  <canvas id="intro-stars" class="absolute inset-0 block size-full mix-blend-screen"></canvas>
  <canvas id="intro-solar" class="absolute inset-0 block size-full"></canvas>

  <div class="absolute inset-0 z-10 flex items-center justify-center">
    <div id="intro-copy" class="flex flex-col items-center">
      <h1
        id="intro-l1"
        class="text-4xl subpixel-antialiased md:text-6xl text-border-2 font-sans text-white font-extrabold text-center opacity-0"
      >
        <span class="text-blue-400">Welcome</span> to <span class="text-blue-400">My Galaxy</span>
      </h1>
      <p
        id="intro-l2"
        class="text-2xl subpixel-antialiased md:text-4xl font-sans text-border-2 text-white border-white font-extrabold space-y-10 text-center mt-10"
      >
        <span class="intro-w opacity-0">A</span> <span class="intro-w opacity-0">space</span> <span class="intro-w opacity-0">to</span> <span class="intro-w opacity-0">host</span> <span class="intro-w opacity-0">my</span> <span class="intro-w opacity-0 text-blue-300">Personal</span> <span class="intro-w opacity-0 text-white">/</span> <span class="intro-w opacity-0 text-blue-300">Professional</span> <span class="intro-w opacity-0">works.</span>
      </p>
      <p
        id="intro-l3"
        class="text-2xl subpixel-antialiased md:text-4xl font-sans text-border-2 text-white border-white font-extrabold space-y-10 text-center mt-10 opacity-0"
      >
        Let's Explore !!....
      </p>
    </div>
  </div>
</div>

<script>
  import { startIntro } from "../lib/intro/controller";

  startIntro();
</script>
